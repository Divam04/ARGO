rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/guards/$(request.auth.uid)).data.role == 'admin'
      );
    }

    match /config/{doc} {
      allow read, write: if isAdmin();
    }

    match /students/{uid} {
      allow read, write: if true;
    }

    match /parcels/{id} {
      allow read, write: if true;
    }

    match /guards/{id} {
      allow read, write: if true;
    }

    match /racks/{id} {
      allow read, write: if true;
    }

    match /emails/{id} {
      allow read, write: if true;
    }

    match /pinAttempts/{id} {
      allow read, write: if true;
    }

    match /settings/{doc} {
      allow read, write: if true;
    }
  }
}
